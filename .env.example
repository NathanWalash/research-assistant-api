RESEARCH_API_APP_NAME="Research Assistant API"
RESEARCH_API_APP_VERSION="0.1.0"
RESEARCH_API_ENVIRONMENT="development"
RESEARCH_API_DEBUG=false
RESEARCH_API_API_PREFIX=""
# Local Docker Compose publishes PostgreSQL on 5433 to avoid 5432 conflicts.
RESEARCH_API_DATABASE_URL="postgresql+psycopg://research_user:research_password@localhost:5433/research_assistant"
# Replace this value before using production mode.
RESEARCH_API_JWT_SECRET_KEY="change-this-development-secret"
RESEARCH_API_JWT_ALGORITHM="HS256"
RESEARCH_API_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RESEARCH_API_EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
RESEARCH_API_EMBEDDING_BATCH_SIZE=32
RESEARCH_API_EMBEDDING_DIMENSIONS=384
RESEARCH_API_CITATION_EDGES_CSV_PATH="data/derived/leeds_citation_edges.csv"
