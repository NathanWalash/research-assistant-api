{
  "name": "research-assistant-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild ./react-src/main.jsx --bundle --format=esm --target=es2020 --outfile=./main.js",
    "build:prod": "esbuild ./react-src/main.jsx --bundle --format=esm --target=es2020 --minify --outfile=./main.js",
    "dev": "esbuild ./react-src/main.jsx --bundle --format=esm --target=es2020 --outfile=./main.js --sourcemap --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
